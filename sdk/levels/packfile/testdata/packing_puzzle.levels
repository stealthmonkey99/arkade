  // 'X' at (r, c) is a divider along cell (r, c)'s TOP edge.
  layer hfix
  |..........|
  |..........|
  |..........|
  |..........|
  |..........|
  |.....X....|
  |..........|
  |..........|
  |.X.......X|
  // 'X' at (r, c) is a divider along cell (r, c)'s LEFT edge — eleven
  // columns for a ten-column tray.
  layer vfix
