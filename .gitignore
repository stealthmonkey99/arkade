# Go build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.out
coverage.html

# Runtime state
/data/

# Vendored C sources for the LED matrix binding: the header and its licence
# are committed so ledpanel's cgo declarations stay analyzable; the lib builds on the Pi.
/third_party/*
!/third_party/rpi-rgb-led-matrix/
/third_party/rpi-rgb-led-matrix/*
!/third_party/rpi-rgb-led-matrix/include/
!/third_party/rpi-rgb-led-matrix/COPYING
!/third_party/rpi-rgb-led-matrix/README.md

# Editors
.vscode/
.idea/
*.swp
.DS_Store

# Env
.env
.env.local

# Packaged cartridge bundles: built locally, never committed
*.rcart

# sdk/template and sdk/tutorial are their own Go modules; a bare
# `go build ./...` inside one produces a stray command binary named after
# the module, distinct from the checked-in .wasm.
/sdk/template/arkade-cart-template
/sdk/tutorial/arkade-cart-tutorial
