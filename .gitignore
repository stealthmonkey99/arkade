/cmd/arkade-lcdboot/arkade-lcdboot
/cmd/arkadepreview/arkadepreview
/cmd/micmodel/micmodel
/cmd/micprobe/micprobe
/apps/boot/tools/gen-stinger/gen-stinger
/apps/config/tools/gen-boop/gen-boop
/sdk/tools/manifestgen/manifestgen
/sdk/tools/rcartpack/rcartpack
/tools/assetdiff/assetdiff
/tools/genlevelpack/genlevelpack
/tools/manualicon/manualicon
